<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ReqChecker Dark Theme Color Tokens -->
    <!-- Based on design-tokens.json specification -->

    <!-- Background Colors -->
    <Color x:Key="BackgroundBaseColor">#0b0d12</Color>
    <Color x:Key="BackgroundSurfaceColor">#13161d</Color>
    <Color x:Key="BackgroundElevatedColor">#1c2029</Color>
    <Color x:Key="BackgroundOverlayColor">#252a35</Color>

    <SolidColorBrush x:Key="BackgroundBase" Color="{StaticResource BackgroundBaseColor}"/>
    <SolidColorBrush x:Key="BackgroundSurface" Color="{StaticResource BackgroundSurfaceColor}"/>
    <SolidColorBrush x:Key="BackgroundElevated" Color="{StaticResource BackgroundElevatedColor}"/>
    <SolidColorBrush x:Key="BackgroundOverlay" Color="{StaticResource BackgroundOverlayColor}"/>

    <!-- Text Colors (WCAG AA compliant) -->
    <!-- Primary: #f0f2f5 on #0b0d12 = 16.1:1 contrast ratio - PASS -->
    <Color x:Key="TextPrimaryColor">#f0f2f5</Color>
    <!-- Secondary: #a8b0bd on #0b0d12 = 7.5:1 contrast ratio - PASS -->
    <Color x:Key="TextSecondaryColor">#a8b0bd</Color>
    <!-- Tertiary: #6e7787 on #0b0d12 = 4.6:1 contrast ratio - PASS -->
    <Color x:Key="TextTertiaryColor">#6e7787</Color>

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextTertiaryColor}"/>

    <!-- Border Colors -->
    <Color x:Key="BorderSubtleColor">#23272f</Color>
    <Color x:Key="BorderDefaultColor">#2e333d</Color>
    <Color x:Key="BorderStrongColor">#424955</Color>

    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderDefault" Color="{StaticResource BorderDefaultColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>

    <!-- Accent Colors -->
    <Color x:Key="AccentPrimaryColor">#4f7cff</Color>

    <SolidColorBrush x:Key="AccentPrimary" Color="{StaticResource AccentPrimaryColor}"/>

    <!-- Brush suffix aliases for WPF-UI naming pattern consistency -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}"/>

    <!-- Semi-transparent accent tint (10% opacity of accent) -->
    <SolidColorBrush x:Key="AccentSubtle" Color="#1A4f7cff"/>

    <!-- Semantic Colors (Status) -->
    <Color x:Key="StatusPassColor">#22c55e</Color>
    <Color x:Key="StatusFailColor">#f87171</Color>
    <Color x:Key="StatusSkipColor">#fbbf24</Color>
    <Color x:Key="StatusInfoColor">#38bdf8</Color>

    <SolidColorBrush x:Key="StatusPass" Color="{StaticResource StatusPassColor}"/>
    <SolidColorBrush x:Key="StatusFail" Color="{StaticResource StatusFailColor}"/>
    <SolidColorBrush x:Key="StatusSkip" Color="{StaticResource StatusSkipColor}"/>
    <SolidColorBrush x:Key="StatusInfo" Color="{StaticResource StatusInfoColor}"/>

    <!-- Status Glow Colors (for badge effects) -->
    <Color x:Key="StatusPassGlowColor">#4D22c55e</Color>
    <Color x:Key="StatusFailGlowColor">#4Df87171</Color>
    <Color x:Key="StatusSkipGlowColor">#4Dfbbf24</Color>

    <!-- Elevation Shadow (for dark theme cards) -->
    <Color x:Key="ElevationShadowColor">#80000000</Color>
    <Color x:Key="ElevationShadowHoverColor">#99000000</Color>
    <Color x:Key="ElevationShadowModalColor">#A6000000</Color>

    <!-- Focus Ring -->
    <Color x:Key="FocusRingColor">#804f7cff</Color>
    <SolidColorBrush x:Key="FocusRing" Color="{StaticResource FocusRingColor}"/>

    <!-- WPF-UI NavigationView Pane Background Overrides -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource BackgroundBaseColor}"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource BackgroundBaseColor}"/>
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{StaticResource BackgroundBaseColor}"/>

    <!-- WPF-UI Control Backgrounds -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource BackgroundSurfaceColor}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource BackgroundElevatedColor}"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource BackgroundOverlayColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource BackgroundSurfaceColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource BackgroundElevatedColor}"/>

    <!-- WPF-UI Window/App Background -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource BackgroundBaseColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource BackgroundBaseColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource BackgroundSurfaceColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource BackgroundElevatedColor}"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource BackgroundSurfaceColor}"/>

    <!-- WPF-UI Text Fill Colors (Dark Theme Overrides) -->
    <!-- These override WPF-UI's default text colors to use light text for dark backgrounds -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource TextTertiaryColor}"/>

    <!-- WPF-UI NavigationView Item Foreground Colors (Dark Theme Overrides) -->
    <!-- Restore proper navigation text visibility in dark mode -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="{StaticResource TextPrimaryColor}"/>

    <!-- WPF-UI ToggleButton Foreground Override (for NavigationView pane toggle) -->
    <!-- Fixes dark mode visibility for "Navigation" header text and hamburger menu -->
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{StaticResource TextTertiaryColor}"/>

    <!-- WPF-UI NavigationView Item Background Colors (Dark Theme Overrides) -->
    <!-- Navigation panel styling for dark mode -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource BackgroundElevatedColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource BackgroundSurfaceColor}"/>

</ResourceDictionary>
