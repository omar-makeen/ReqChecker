<Window x:Class="ReqChecker.App.Views.CreateScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:ReqChecker.App.Converters"
        xmlns:enums="clr-namespace:ReqChecker.Core.Enums;assembly=ReqChecker.Core"
        mc:Ignorable="d"
        Title="Schedule Test Run"
        Height="620"
        Width="540"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBase}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Entrance animation -->
        <Storyboard x:Key="EntranceAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntranceAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentPanel" Margin="32">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <Border Background="{DynamicResource AccentGradientHorizontal}"
                        CornerRadius="12"
                        Width="48" Height="48"
                        Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="CalendarClock24"
                                   FontSize="24"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveButtonText, StringFormat='{}{0} Schedule'}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Configure when to run tests automatically"
                               Style="{DynamicResource TextCaption}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">

                <!-- Schedule Name -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Schedule Name"
                               Style="{DynamicResource TextBody}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputField}"
                             TabIndex="0"
                             ToolTip="A name to identify this schedule"
                             ToolTipService.InitialShowDelay="400"/>
                </StackPanel>

                <!-- Profile File -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Test Profile"
                               Style="{DynamicResource TextBody}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ProfileFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputField}"
                                 IsReadOnly="True"
                                 TabIndex="1"
                                 ToolTip="Path to the test profile JSON file"/>
                        <Button Grid.Column="1"
                                x:Name="BrowseButton"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="2"
                                Margin="8,0,0,0"
                                ToolTip="Browse for a profile file"
                                ToolTipService.InitialShowDelay="400">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Browse"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Schedule Type -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Schedule Type"
                               Style="{DynamicResource TextBody}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="One-time"
                                     IsChecked="{Binding IsOneTime}"
                                     TabIndex="3"
                                     Margin="0,0,24,0"/>
                        <RadioButton Content="Recurring"
                                     IsChecked="{Binding IsRecurring}"
                                     TabIndex="4"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── ONE-TIME SECTION ── -->
                <StackPanel Visibility="{Binding IsOneTime, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Scheduled Date -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Date"
                                   Style="{DynamicResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding ScheduledDate}"
                                    TabIndex="5"
                                    ToolTip="Date to run the test"
                                    ToolTipService.InitialShowDelay="400"/>
                    </StackPanel>

                    <!-- Scheduled Time -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Time"
                                   Style="{DynamicResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="ScheduledHourBox"
                                      Width="80"
                                      SelectedValue="{Binding ScheduledHour}"
                                      SelectedValuePath="Tag"
                                      TabIndex="6"
                                      ToolTip="Hour (0-23)"
                                      ToolTipService.InitialShowDelay="400"/>
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0" FontSize="18" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ScheduledMinuteBox"
                                      Width="80"
                                      SelectedValue="{Binding ScheduledMinute}"
                                      SelectedValuePath="Tag"
                                      TabIndex="7"
                                      ToolTip="Minute"
                                      ToolTipService.InitialShowDelay="400"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ── RECURRING SECTION ── -->
                <StackPanel Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Recurrence Type -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Repeat"
                                   Style="{DynamicResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding RecurrenceType}"
                                  SelectedValuePath="Tag"
                                  TabIndex="8"
                                  ToolTip="How often to repeat"
                                  ToolTipService.InitialShowDelay="400">
                            <ComboBoxItem Content="Every hour" Tag="{x:Static enums:RecurrenceType.Hourly}"/>
                            <ComboBoxItem Content="Every day" Tag="{x:Static enums:RecurrenceType.Daily}"/>
                            <ComboBoxItem Content="Weekly" Tag="{x:Static enums:RecurrenceType.Weekly}"/>
                            <ComboBoxItem Content="Custom interval" Tag="{x:Static enums:RecurrenceType.CustomInterval}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Custom Interval inputs -->
                    <StackPanel Visibility="{Binding IsCustomInterval, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,16">
                        <TextBlock Text="Interval"
                                   Style="{DynamicResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding IntervalValue, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputField}"
                                     Width="80"
                                     TabIndex="9"
                                     ToolTip="Interval value (minimum 5 minutes)"
                                     ToolTipService.InitialShowDelay="400"/>
                            <ComboBox SelectedValue="{Binding IntervalUnit}"
                                      SelectedValuePath="Tag"
                                      Margin="8,0,0,0"
                                      Width="120"
                                      TabIndex="10"
                                      ToolTip="Unit of interval"
                                      ToolTipService.InitialShowDelay="400">
                                <ComboBoxItem Content="Minutes" Tag="{x:Static enums:IntervalUnit.Minutes}"/>
                                <ComboBoxItem Content="Hours" Tag="{x:Static enums:IntervalUnit.Hours}"/>
                                <ComboBoxItem Content="Days" Tag="{x:Static enums:IntervalUnit.Days}"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hourly interval input -->
                    <StackPanel Visibility="{Binding IsHourly, Converter={StaticResource BoolToVisibilityConverter}}"
                                Orientation="Horizontal"
                                Margin="0,0,0,16">
                        <TextBlock Text="Every"
                                   Style="{DynamicResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Text="{Binding IntervalValue, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputField}"
                                 Width="60"
                                 TabIndex="9"
                                 ToolTip="Number of hours between runs"
                                 ToolTipService.InitialShowDelay="400"/>
                        <TextBlock Text="hour(s)"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Weekly day selection -->
                    <StackPanel Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,16">
                        <TextBlock Text="Days of Week"
                                   Style="{DynamicResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding DaysOfWeek}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected}"
                                              Margin="0,0,16,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Time of day (for Daily + Weekly) -->
                    <StackPanel Visibility="{Binding IsCustomInterval, Converter={StaticResource BoolToVisibilityConverter},
                                             ConverterParameter=Inverse}"
                                Margin="0,0,0,16">
                        <StackPanel Visibility="{Binding IsHourly, Converter={StaticResource BoolToVisibilityConverter},
                                                 ConverterParameter=Inverse}">
                            <TextBlock Text="Time of Day"
                                       Style="{DynamicResource TextBody}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="TimeOfDayHourBox"
                                          Width="80"
                                          SelectedValue="{Binding TimeOfDayHour}"
                                          SelectedValuePath="Tag"
                                          TabIndex="11"
                                          ToolTip="Hour (0-23)"
                                          ToolTipService.InitialShowDelay="400"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0" FontSize="18" FontWeight="SemiBold"/>
                                <ComboBox x:Name="TimeOfDayMinuteBox"
                                          Width="80"
                                          SelectedValue="{Binding TimeOfDayMinute}"
                                          SelectedValuePath="Tag"
                                          TabIndex="12"
                                          ToolTip="Minute"
                                          ToolTipService.InitialShowDelay="400"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Optional end date -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="End Date (optional)"
                                   Style="{DynamicResource TextBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding EndDate}"
                                    TabIndex="13"
                                    ToolTip="Stop recurring after this date (leave blank to run indefinitely)"
                                    ToolTipService.InitialShowDelay="400"/>
                    </StackPanel>
                </StackPanel>

                <!-- Error Message -->
                <Border Background="#1AEF4444"
                        BorderBrush="{DynamicResource StatusFail}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,8,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ErrorCircle24"
                                       FontSize="18"
                                       Foreground="{DynamicResource StatusFail}"
                                       Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource StatusFail}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Content="Cancel"
                        MinWidth="100"
                        TabIndex="20"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        ToolTip="Cancel and close this dialog"
                        ToolTipService.InitialShowDelay="400"/>

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        MinWidth="120"
                        TabIndex="21"
                        IsDefault="True"
                        ToolTip="Save the schedule"
                        ToolTipService.InitialShowDelay="400">
                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SaveButtonText}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
