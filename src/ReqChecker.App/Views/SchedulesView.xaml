<Page x:Class="ReqChecker.App.Views.SchedulesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:ReqChecker.App.Converters"
      xmlns:vm="clr-namespace:ReqChecker.App.ViewModels"
      xmlns:enums="clr-namespace:ReqChecker.Core.Enums;assembly=ReqChecker.Core"
      mc:Ignorable="d"
      Background="{DynamicResource BackgroundBase}"
      Loaded="OnPageLoaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Status badge styles -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Schedule item card -->
        <Style x:Key="AnimatedScheduleItem" TargetType="Border">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="16"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="16" To="0"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource AnimatedPageHeader}" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Gradient Accent Line -->
                <Border Grid.Row="0" Height="4"
                        Background="{DynamicResource AccentGradientHorizontal}"
                        CornerRadius="2"/>

                <!-- Header Content -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back Button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding NavigateBackCommand}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            ToolTip="Return to the test suite"
                            ToolTipService.InitialShowDelay="400"
                            ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Back to Tests"/>
                        </StackPanel>
                    </Button>

                    <!-- Icon Container -->
                    <Border Grid.Column="1" Width="48" Height="48"
                            Background="{DynamicResource AccentPrimary}"
                            CornerRadius="12" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="CalendarClock24"
                                       FontSize="24"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title + Subtitle -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Schedules"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Automate test runs at specific times"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Create Button -->
                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateScheduleCommand}"
                            TabIndex="0"
                            ToolTip="Create a new schedule"
                            ToolTipService.InitialShowDelay="400"
                            ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="New Schedule"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Message -->
        <Border Grid.Row="1"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"
                Margin="0,0,0,16"
                Padding="16,12"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A10B981"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusPass}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#1AEF4444"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource StatusFail}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon FontSize="16" Margin="0,0,8,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                            <Setter Property="Foreground" Value="{DynamicResource StatusPass}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Symbol" Value="ErrorCircle24"/>
                                    <Setter Property="Foreground" Value="{DynamicResource StatusFail}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource StatusPass}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusFail}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Loading -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"/>
                <TextBlock Text="Loading schedules..."
                           Style="{DynamicResource TextBody}"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="400"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{DynamicResource BackgroundElevated}"
                        CornerRadius="50"
                        Width="80" Height="80"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <ui:SymbolIcon Symbol="CalendarClock24"
                                   FontSize="36"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No schedules yet"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Create a schedule to automatically run your tests at a specific time."
                           Style="{DynamicResource TextBody}"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreateScheduleCommand}"
                        HorizontalAlignment="Center"
                        ToolTip="Create your first schedule"
                        ToolTipService.InitialShowDelay="400">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Create Schedule"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Schedule list -->
            <ScrollViewer Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Schedules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScheduleItemViewModel}">
                            <Border Style="{StaticResource AnimatedScheduleItem}"
                                    Background="{DynamicResource BackgroundElevated}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20,16"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: info -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Name + badges -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Type badge -->
                                            <Border Style="{StaticResource StatusBadge}"
                                                    Background="{DynamicResource AccentSubtle}"
                                                    Margin="10,0,0,0">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="11" FontWeight="Medium"
                                                           Foreground="{DynamicResource AccentPrimary}"/>
                                            </Border>

                                            <!-- Status badge -->
                                            <Border Margin="6,0,0,0" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1A6EE7FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Paused}">
                                                                <Setter Property="Background" Value="#1AF59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Completed}">
                                                                <Setter Property="Background" Value="#1A71717A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Expired}">
                                                                <Setter Property="Background" Value="#1AEF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Missed}">
                                                                <Setter Property="Background" Value="#1AF97316"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#FF6EE7FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Paused}">
                                                                    <Setter Property="Foreground" Value="#FFF59E0B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Completed}">
                                                                    <Setter Property="Foreground" Value="#FF71717A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Expired}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusFail}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:ScheduleStatus.Missed}">
                                                                    <Setter Property="Foreground" Value="#FFF97316"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Profile name -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                            <ui:SymbolIcon Symbol="Document24" FontSize="14"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ProfileName}"
                                                       Style="{DynamicResource TextBody}"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>

                                        <!-- Next run + last run -->
                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="13"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               Margin="0,0,5,0"/>
                                                <TextBlock Style="{DynamicResource TextCaption}"
                                                           Foreground="{DynamicResource TextTertiary}">
                                                    <Run Text="Next: "/>
                                                     <Run Text="{Binding NextRunLabel, Mode=OneWay}" FontWeight="Medium"
                                                         Foreground="{DynamicResource TextSecondary}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="History24" FontSize="13"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               Margin="0,0,5,0"/>
                                                <TextBlock Style="{DynamicResource TextCaption}"
                                                           Foreground="{DynamicResource TextTertiary}">
                                                    <Run Text="Last: "/>
                                                     <Run Text="{Binding LastRunLabel, Mode=OneWay}" FontWeight="Medium"
                                                         Foreground="{DynamicResource TextSecondary}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- Right: action buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                        <!-- Pause / Resume -->
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.TogglePauseCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanPauseOrResume, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,0,8,0"
                                                ToolTipService.InitialShowDelay="400">
                                            <Button.ToolTip>
                                                <MultiBinding StringFormat="{}{0} this schedule">
                                                    <Binding Path="PauseResumeLabel"/>
                                                </MultiBinding>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon FontSize="14" Margin="0,0,6,0">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Pause24"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanResume}" Value="True">
                                                                    <Setter Property="Symbol" Value="Play24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="{Binding PauseResumeLabel}"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Edit -->
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.EditScheduleCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,0,8,0"
                                                ToolTip="Edit this schedule"
                                                ToolTipService.InitialShowDelay="400">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Edit"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Delete -->
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.DeleteScheduleCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete this schedule permanently"
                                                ToolTipService.InitialShowDelay="400">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
