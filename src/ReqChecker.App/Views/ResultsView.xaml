<Page x:Class="ReqChecker.App.Views.ResultsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:ReqChecker.App.Controls"
      xmlns:converters="clr-namespace:ReqChecker.App.Converters"
      xmlns:vm="clr-namespace:ReqChecker.App.ViewModels"
      mc:Ignorable="d"
      Background="{DynamicResource BackgroundBase}"
      FocusManager.FocusedElement="{Binding ElementName=BackToTestsButton}">

    <Page.Resources>
        <converters:CredentialMaskConverter x:Key="CredentialMaskConverter"/>

        <!-- Export popup open animation -->
        <Storyboard x:Key="ExportPopupOpenStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="4" To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Filter transition fade-out storyboard -->
        <Storyboard x:Key="FilterFadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Filter transition fade-in storyboard -->
        <Storyboard x:Key="FilterFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>


    </Page.Resources>

    <Page.InputBindings>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ToggleExportMenuCommand}"/>
    </Page.InputBindings>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="{StaticResource SpacingHeaderToBody}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackToTestsButton"
                    Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding NavigateToTestListCommand}"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    ToolTip="Return to the test suite"
                    ToolTipService.InitialShowDelay="400"
                    ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Back to Tests"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="Results Dashboard"
                       Style="{StaticResource PageTitleStyle}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding RerunFailedTestsCommand}"
                        Visibility="{Binding HasFailedTests, Converter={StaticResource BoolToVisibilityConverter}}"
                        TabIndex="2"
                        ToolTip="Re-execute only the tests that failed or were skipped due to dependencies"
                        ToolTipService.InitialShowDelay="400"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Re-run Failed"/>
                    </StackPanel>
                </Button>

                <Grid>
                    <Button x:Name="ExportDropdownButton"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleExportMenuCommand}"
                            IsEnabled="{Binding CanExportNow}"
                            TabIndex="3"
                            ToolTip="Save test results in PDF, CSV, or JSON format"
                            ToolTipService.InitialShowDelay="400">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Export"/>
                            <ui:SymbolIcon Symbol="ChevronDown20" FontSize="12" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Button>

                   <Popup x:Name="ExportPopup"
                           PlacementTarget="{Binding ElementName=ExportDropdownButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="None"
                           IsOpen="{Binding IsExportMenuOpen, Mode=TwoWay}"
                           Opened="ExportPopup_Opened">
                        <Border x:Name="PopupBorder"
                                Background="{DynamicResource BackgroundElevated}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Margin="8"
                                MinWidth="180"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0"
                                PreviewKeyDown="ExportPopup_PreviewKeyDown">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PopupTranslate" Y="4"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ElevationShadowHoverColor}"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="1"/>
                            </Border.Effect>
                            <StackPanel x:Name="ExportMenuItems">
                                <Button Style="{StaticResource ExportMenuItemButton}"
                                        Command="{Binding ExportToPdfCommand}"
                                        ToolTip="Export results as a formatted PDF document"
                                        ToolTipService.InitialShowDelay="400"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Document24" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="PDF Document"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ExportMenuItemButton}"
                                        Command="{Binding ExportToCsvCommand}"
                                        ToolTip="Export results as a CSV spreadsheet for analysis"
                                        ToolTipService.InitialShowDelay="400"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Table24" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="CSV Spreadsheet"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ExportMenuItemButton}"
                                        Command="{Binding ExportToJsonCommand}"
                                        ToolTip="Export results as JSON data for integration"
                                        ToolTipService.InitialShowDelay="400"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Code24" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="JSON Data"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Status Message -->
        <Border Grid.Row="1"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"
                Margin="0,0,0,16"
                Padding="16,12"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A10B981"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusPass}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#1AEF4444"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource StatusFail}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon FontSize="16" Margin="0,0,8,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                            <Setter Property="Foreground" Value="{DynamicResource StatusPass}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Symbol" Value="ErrorCircle24"/>
                                    <Setter Property="Foreground" Value="{DynamicResource StatusFail}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource StatusPass}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusFail}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Summary Dashboard -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="0,0,0,24"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Donut Chart -->
                <controls:DonutChart Grid.Column="0"
                                     Width="100"
                                     Height="100"
                                     Passed="{Binding Report.Summary.Passed}"
                                     Failed="{Binding Report.Summary.Failed}"
                                     Skipped="{Binding Report.Summary.Skipped}"
                                     CenterLabel="Tests"
                                     Margin="0,0,24,0"/>

                <!-- Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Profile: "
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Report.ProfileName}"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="350"
                                   ToolTip="{Binding Report.ProfileName}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Started: "
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Report.StartTime, Converter={StaticResource FriendlyDateConverter}}"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Duration: "
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Report.Duration, Converter={StaticResource DurationFormatConverter}}"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Summary Cards -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <controls:SummaryCard Value="{Binding Report.Summary.Passed}"
                                          Label="Passed"
                                          Icon="CheckmarkCircle24"
                                          ShowIcon="False"
                                          AccentColor="#10B981"
                                          Margin="0,0,12,0"/>

                    <controls:SummaryCard Value="{Binding Report.Summary.Failed}"
                                          Label="Failed"
                                          Icon="DismissCircle24"
                                          ShowIcon="False"
                                          AccentColor="#EF4444"
                                          Margin="0,0,12,0"/>

                    <controls:SummaryCard Value="{Binding Report.Summary.Skipped}"
                                          Label="Skipped"
                                          Icon="ArrowRight24"
                                          ShowIcon="False"
                                          AccentColor="#F59E0B"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Empty state when no report (no prior test run) -->
        <Border Grid.Row="4"
                Background="{DynamicResource BackgroundSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse, FallbackValue=Visible}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Poll24"
                               FontSize="48"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                <TextBlock Text="No test results available"
                           Style="{DynamicResource TextBody}"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8"/>
                <TextBlock Text="Run tests to see results here"
                           Style="{DynamicResource TextBody}"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <Button Style="{StaticResource GhostButton}"
                         Content="Go to Tests"
                         Command="{Binding NavigateToTestListCommand}"
                         HorizontalAlignment="Center"
                         ToolTip="Navigate to the test suite"
                         ToolTipService.InitialShowDelay="400"
                         ToolTipService.ShowOnDisabled="True"/>
            </StackPanel>
        </Border>

        <!-- Filter Tabs -->
        <Border Grid.Row="3"
                Background="{DynamicResource BackgroundSurface}"
                CornerRadius="8"
                Padding="4"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterTab}"
                             Content="All"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:ResultsFilter.All}}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="{x:Static vm:ResultsFilter.All}"/>
                <RadioButton Style="{StaticResource FilterTab}"
                             Margin="4,0,0,0"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="{x:Static vm:ResultsFilter.Passed}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusPass}" Margin="0,0,6,0"/>
                        <TextBlock Text="Passed"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterTab}"
                             Margin="4,0,0,0"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="{x:Static vm:ResultsFilter.Failed}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusFail}" Margin="0,0,6,0"/>
                        <TextBlock Text="Failed"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterTab}"
                             Margin="4,0,0,0"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="{x:Static vm:ResultsFilter.Skipped}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusSkip}" Margin="0,0,6,0"/>
                        <TextBlock Text="Skipped"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Test Results List with virtualization -->
        <Grid x:Name="FilterTransitionContainer" Grid.Row="4">
            <ListBox ItemsSource="{Binding FilteredResults}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionMode="Single"
                     AutomationProperties.Name="Test results list"
                     Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <controls:ExpanderCard Title="{Binding DisplayName}"
                                           Subtitle="{Binding Duration, Converter={StaticResource DurationFormatConverter}}"
                                           Status="{Binding Status}"
                                           TestDuration="{Binding Duration}"
                                           AttemptCount="{Binding AttemptCount}"
                                           Summary="{Binding Converter={StaticResource TestResultSummaryConverter}}"
                                           TechnicalDetails="{Binding Converter={StaticResource TechnicalDetailsConverter}}"
                                           ErrorMessage="{Binding Error.Message}"
                                           ErrorCategory="{Binding Error.Category}"
                                           AutomationProperties.Name="{Binding DisplayName}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state when filtered results are empty -->
        <Border Background="{DynamicResource BackgroundSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding FilteredResults.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Filter24"
                               FontSize="48"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                <TextBlock Text="No results match the current filter"
                           Style="{DynamicResource TextBody}"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
                <Button Style="{StaticResource GhostButton}"
                         Content="Clear Filter"
                         Command="{Binding SetFilterCommand}"
                         CommandParameter="{x:Static vm:ResultsFilter.All}"
                         HorizontalAlignment="Center"
                         Margin="0,12,0,0"
                         ToolTip="Show all test results"
                         ToolTipService.InitialShowDelay="400"
                         ToolTipService.ShowOnDisabled="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</Page>
