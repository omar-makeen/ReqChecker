<Page x:Class="ReqChecker.App.Views.ProfileSelectorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
       xmlns:converters="clr-namespace:ReqChecker.App.Converters"
       mc:Ignorable="d"
      Background="{DynamicResource BackgroundBase}"
      FocusManager.FocusedElement="{Binding ElementName=RefreshButton}">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Banner dismiss animation -->
        <Storyboard x:Key="BannerDismissStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-10"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="ProfileRowChrome" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BackgroundElevated}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource ElevationShadowColor}"
                                              BlurRadius="15"
                                              ShadowDepth="0"
                                              Opacity="0.3"
                                              Direction="0"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnimatedProfileRow" TargetType="Border" BasedOn="{StaticResource ProfileRowChrome}">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="8"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="8" To="0"
                                             Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileRowStatic" TargetType="Border" BasedOn="{StaticResource ProfileRowChrome}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource AnimatedPageHeader}" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Accent Line -->
                <Border Grid.Row="0" Height="4"
                        Background="{DynamicResource AccentPrimary}"
                        CornerRadius="2"/>

                <!-- Header Content -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Container -->
                    <Border Grid.Column="0" Width="48" Height="48"
                            Background="{DynamicResource AccentPrimary}"
                            CornerRadius="12" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Folder24"
                                       FontSize="24"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title + Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Profile Manager"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Manage and import test profiles"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                     <!-- Action Buttons -->
                     <StackPanel Grid.Column="2" Orientation="Horizontal">
                         <Button x:Name="RefreshButton"
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding LoadProfilesCommand}"
                                 TabIndex="1"
                                 ToolTip="Reload profiles from disk"
                                 ToolTipService.InitialShowDelay="400"
                                 Margin="0,0,8,0">
                             <StackPanel Orientation="Horizontal">
                                 <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,8,0"/>
                                 <TextBlock Text="Refresh"/>
                             </StackPanel>
                         </Button>

                         <!-- Import Button with drag-drop styling -->
                         <Button Style="{StaticResource PrimaryButton}"
                                 Command="{Binding ImportProfileCommand}"
                                 TabIndex="2"
                                 ToolTip="Import a test profile from a JSON file"
                                 ToolTipService.InitialShowDelay="400"
                                 AllowDrop="True">
                             <StackPanel Orientation="Horizontal">
                                 <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Margin="0,0,8,0"/>
                                 <TextBlock Text="Import Profile"/>
                             </StackPanel>
                         </Button>
                     </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Welcome Banner -->
        <Border x:Name="WelcomeBanner"
                Grid.Row="1"
                Style="{StaticResource WelcomeBanner}"
                Visibility="{Binding ShowWelcomeBanner, Converter={StaticResource BoolToVisibilityConverter}}"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform Y="0"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Border Grid.Column="0" Width="48" Height="48"
                        Background="{DynamicResource AccentPrimary}"
                        CornerRadius="12" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="Lightbulb24"
                                   FontSize="24"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Welcome to ReqChecker"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Verify your environment meets requirements. Select a profile below to define which checks to run."
                               Style="{DynamicResource TextBody}"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Dismiss Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding DismissWelcomeBannerCommand}"
                        Click="DismissBanner_Click"
                        TabIndex="3"
                        Width="40" Height="40"
                        Padding="0"
                        VerticalAlignment="Top"
                        ToolTip="Dismiss welcome banner"
                        ToolTipService.InitialShowDelay="400"
                        ToolTipService.ShowOnDisabled="True">
                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="20"
                                   Foreground="{DynamicResource TextSecondary}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Error Message -->
        <Border Grid.Row="2"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                BorderBrush="{DynamicResource StatusFail}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,16">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource StatusFailGlowColor}"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource StatusFailColor}"
                                  Opacity="0.3"
                                  BlurRadius="16"
                                  ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle24"
                                   FontSize="20"
                                   Foreground="{DynamicResource StatusFail}"
                                   Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                                Foreground="{DynamicResource StatusFail}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ClearErrorCommand}"
                        Content="Dismiss"
                        TabIndex="3"
                        ToolTip="Dismiss error message"
                        ToolTipService.InitialShowDelay="400"
                        ToolTipService.ShowOnDisabled="True"/>
            </Grid>
        </Border>

        <!-- Profile List Area -->
        <Grid Grid.Row="3">
            <!-- Virtualized Profile List (T006/T007) -->
            <ListBox x:Name="ProfileListBox"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.Name="Profiles list"
                     KeyDown="ProfileListBox_KeyDown"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- DynamicResource required: code-behind swaps this resource for reduced-motion -->
                        <Border x:Name="RowChrome" Padding="16" Cursor="Hand"
                                Tag="{Binding Profile}"
                                MouseLeftButtonUp="Row_MouseLeftButtonUp"
                                ToolTip="{Binding Name}"
                                ToolTipService.InitialShowDelay="400"
                                AutomationProperties.Name="{Binding AccessibleName}"
                                Style="{DynamicResource AnimatedProfileRow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top row: Name + Recommended badge + kebab actions -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <!-- Recommended Badge -->
                                    <Border Grid.Column="1"
                                            Style="{StaticResource RecommendedBadge}"
                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Recommended"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="White"/>
                                    </Border>

                                    <!-- Row actions kebab — user-source rows only -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Click="Kebab_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding SourceFilePath, Converter={StaticResource NullToVisibilityConverter}}"
                                            Margin="8,0,0,0"
                                            Padding="6"
                                            VerticalAlignment="Center"
                                            ToolTip="More actions"
                                            ToolTipService.InitialShowDelay="400"
                                            AutomationProperties.Name="Profile actions">
                                        <ui:SymbolIcon Symbol="MoreVertical24" FontSize="16"/>
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Open file location"
                                                          Click="OpenFileLocationMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Delete"
                                                          Click="DeleteProfileMenuItem_Click"
                                                          Foreground="{DynamicResource StatusFail}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14"
                                                                       Foreground="{DynamicResource StatusFail}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>

                                <!-- Bottom row: metadata segments -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <!-- Source chip -->
                                    <Border BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="8,2">
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>

                                    <TextBlock Text=" · " Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="6,0"/>

                                    <!-- Test count -->
                                    <TextBlock Text="{Binding TestCountLabel}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>

                                    <!-- Schema version -->
                                    <TextBlock Text=" · " Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="6,0"
                                               Visibility="{Binding SchemaVersionLabel, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding SchemaVersionLabel}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SchemaVersionLabel, Converter={StaticResource NullToVisibilityConverter}}"/>

                                    <!-- Modified date -->
                                    <TextBlock Text=" · " Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="6,0"
                                               Visibility="{Binding ModifiedLabel, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding ModifiedLabel}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ModifiedLabel, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State -->
            <Border Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}"
                    Background="{DynamicResource BackgroundSurface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,48,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon Composition -->
                    <Grid Width="80" Height="80" Margin="0,0,0,24">
                        <Ellipse Fill="{DynamicResource BackgroundElevated}"
                                 Width="80" Height="80"/>
                        <ui:SymbolIcon Symbol="Folder24"
                                       FontSize="36"
                                       Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentPrimary}"
                                CornerRadius="12"
                                Width="24" Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,4,4">
                            <ui:SymbolIcon Symbol="Add24"
                                           FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="No profiles found"
                               Style="{DynamicResource TextH3}"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Import a profile to get started with testing"
                               Style="{DynamicResource TextBody}"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Loading Indicator -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="48" Height="48"/>
                    <TextBlock Text="Loading profiles..."
                               Style="{DynamicResource TextBody}"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
