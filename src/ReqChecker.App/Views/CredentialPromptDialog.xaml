<Window x:Class="ReqChecker.App.Views.CredentialPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:ReqChecker.App.Converters"
        mc:Ignorable="d"
        Title="Credential Required"
        Height="420"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBase}"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    </Window.Resources>

    <Grid x:Name="ContentPanel" Margin="32" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Credential Required"
                       Style="{StaticResource H2TextStyle}"/>
            <TextBlock Text="{Binding FieldLabel}"
                       Style="{DynamicResource TextCaption}"
                       Foreground="{DynamicResource TextTertiary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Credential Reference (if provided) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundElevated}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,20"
                Visibility="{Binding CredentialRef, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24"
                               FontSize="16"
                               Foreground="{DynamicResource AccentPrimary}"
                               Margin="0,0,12,0"/>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="Reference: " FontWeight="Medium"/>
                    <Run Text="{Binding CredentialRef, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <StackPanel Grid.Row="2">
            <!-- Username -->
            <StackPanel Margin="0,0,0,16">
                <Label Content="_Username"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="13"
                       FontWeight="Medium"
                       Margin="0,0,0,8"
                       Target="UsernameTextBox"/>
                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource CredentialInput}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         TabIndex="1"
                         ToolTip="Enter your username for authentication"
                         ToolTipService.InitialShowDelay="400"
                         ToolTipService.ShowOnDisabled="True"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Margin="0,0,0,16">
                <Label Content="_Password"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="13"
                       FontWeight="Medium"
                       Margin="0,0,0,8"
                       Target="PasswordBox"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource CredentialPasswordBox}"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             TabIndex="2"
                             ToolTip="Enter your password for authentication"
                             ToolTipService.InitialShowDelay="400"
                             ToolTipService.ShowOnDisabled="True"/>
            </StackPanel>

            <!-- Remember Credentials -->
            <CheckBox Style="{StaticResource CredentialCheckBox}"
                      Content="Remember credentials for this session"
                      IsChecked="{Binding RememberCredentials}"
                      TabIndex="3"
                      ToolTip="Store credentials in memory for the current session only"
                      ToolTipService.InitialShowDelay="400"
                      ToolTipService.ShowOnDisabled="True"/>

            <!-- Error Message -->
            <Border Background="#1AEF4444"
                    BorderBrush="{DynamicResource StatusFail}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle24"
                                   FontSize="18"
                                   Foreground="{DynamicResource StatusFail}"
                                   Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource StatusFail}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Content="Cancel"
                    MinWidth="100"
                    TabIndex="4"
                    IsCancel="True"
                    ToolTip="Cancel and close this dialog"
                    ToolTipService.InitialShowDelay="400"
                    ToolTipService.ShowOnDisabled="True"
                    Margin="0,0,8,0"/>

            <Button x:Name="SubmitButton"
                    Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="100"
                    TabIndex="5"
                    IsDefault="True"
                    ToolTip="Submit credentials to continue"
                    ToolTipService.InitialShowDelay="400"
                    ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Submit"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
