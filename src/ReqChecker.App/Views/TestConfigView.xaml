<Page x:Class="ReqChecker.App.Views.TestConfigView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:ReqChecker.App.Converters"
      xmlns:controls="clr-namespace:ReqChecker.App.Controls"
      xmlns:viewmodels="clr-namespace:ReqChecker.App.ViewModels"
      mc:Ignorable="d"
      Background="{DynamicResource BackgroundBase}"
      FocusManager.FocusedElement="{Binding ElementName=BackButton}">

    <Page.Resources>
        <converters:FieldPolicyToVisibilityConverter x:Key="FieldPolicyToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="32" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="{StaticResource SpacingHeaderToBody}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    TabIndex="0"
                    Margin="0,0,16,0"
                    ToolTip="Return to the test suite"
                    ToolTipService.InitialShowDelay="400"
                    ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Back to Tests"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="Test Configuration"
                       Style="{StaticResource PageTitleStyle}"/>

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    TabIndex="1"
                    ToolTip="Save test configuration changes"
                    ToolTipService.InitialShowDelay="400"
                    ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Save Changes"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Test Configuration Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Basic Information Section -->
                <StackPanel Margin="{StaticResource SpacingSectionSection}">
                    <TextBlock Text="Basic Information"
                               Style="{StaticResource SectionHeadingStyle}"/>

                    <!-- Test Name (Locked) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Name"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <controls:LockedFieldControl Grid.Column="1" Value="{Binding TestName}"/>
                    </Grid>

                    <!-- Test Type (Locked) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Type"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <controls:LockedFieldControl Grid.Column="1" Value="{Binding TestType}"/>
                    </Grid>

                    <!-- Requires Admin (Locked) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Requires Admin"
                                   Style="{DynamicResource TextBody}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <controls:LockedFieldControl Grid.Column="1" Value="{Binding RequiresAdminText}"/>
                    </Grid>
                </StackPanel>

                <!-- Execution Settings Section -->
                <StackPanel Margin="{StaticResource SpacingSectionSection}">
                    <TextBlock Text="Execution Settings"
                               Style="{StaticResource SectionHeadingStyle}"/>

                    <!-- Timeout -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Content="_Timeout (ms)"
                               Style="{DynamicResource TextBody}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Target="TimeoutTextBox"/>
                         <TextBox x:Name="TimeoutTextBox"
                                  Grid.Column="1"
                                  Style="{StaticResource InputField}"
                                  Text="{Binding Timeout, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                  TabIndex="2"/>
                    </Grid>

                    <!-- Retries -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Content="_Retries"
                               Style="{DynamicResource TextBody}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Target="RetryCountTextBox"/>
                         <TextBox x:Name="RetryCountTextBox"
                                  Grid.Column="1"
                                  Style="{StaticResource InputField}"
                                  Text="{Binding RetryCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                  TabIndex="3"/>
                    </Grid>
                </StackPanel>

                <!-- Test Parameters Section -->
                <StackPanel Margin="{StaticResource SpacingSectionSection}">
                    <TextBlock Text="Test Parameters"
                               Style="{StaticResource SectionHeadingStyle}"/>

                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12"
                                      Visibility="{Binding Policy, Converter={StaticResource FieldPolicyToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Field Label -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               Style="{DynamicResource TextBody}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Label}"
                                               MaxWidth="110"/>

                                    <!-- Editable Field (non-password) -->
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputField}"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsNotPassword, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Password Field (masked input) -->
                                    <PasswordBox x:Name="ParameterPasswordBox"
                                                 Grid.Column="1"
                                                 Style="{StaticResource CredentialPasswordBox}"
                                                 Visibility="{Binding IsPassword, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 PasswordChanged="ParameterPasswordBox_PasswordChanged"/>

                                    <!-- Locked Field -->
                                    <controls:LockedFieldControl Grid.Column="1"
                                                                 Value="{Binding Value}"
                                                                 Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Prompt At Run Field -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0"
                                                Visibility="{Binding IsPromptAtRun, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ui:SymbolIcon Symbol="Key24" FontSize="14"
                                                       Foreground="{DynamicResource AccentPrimary}"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Will be prompted during test execution"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State for Parameters -->
                    <Border Visibility="{Binding Parameters.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            Background="{DynamicResource BackgroundElevated}"
                            CornerRadius="8"
                            Padding="24"
                            HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentBulletList24"
                                           FontSize="32"
                                           Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                            <TextBlock Text="No parameters defined for this test"
                                       Style="{DynamicResource TextBody}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
